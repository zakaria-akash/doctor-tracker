# Copy to .env.local at the project root. Never commit real secrets.
# Base URL of the standalone Express API. Do not expose this as NEXT_PUBLIC_*.
API_URL=http://localhost:4000/api/v1

# Replace this placeholder with a strong shared secret (at least 32 characters).
# These values must match the backend exactly in every environment.
JWT_SECRET=replace-with-the-same-48-byte-secret-as-the-backend
JWT_ISSUER=doctor-tracker-api
JWT_AUDIENCE=doctor-tracker-web
